{
  "name": "@dsh-external/dsh-auto-model-router",
  "version": "0.0.1-beta",
  "description": "System One decision model routes every agent request; subagents are routed by their own task instead of inheriting the parent model.",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node --test \"tests/*.test.mjs\"",
    "build:data": "node scripts/build-model-info.mjs"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
